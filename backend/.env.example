# Chat assistant — OpenCode, via its OpenAI-compatible chat-completions endpoint.
# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# LLM_BASE_URL is the endpoint root, without the /chat/completions suffix.
LLM_BASE_URL=
LLM_MODEL=
OPENCODE_API_KEY=

# Optional. Defaults shown.
# CHAT_MAX_ROUNDS=6
# CHAT_TIMEOUT_SECONDS=30
# CHAT_MAX_HISTORY=20

# Postgres instead of the default SQLite:
# DATABASE_URL=postgresql+asyncpg://dewdrop:dewdrop@localhost:5432/dewdrop
